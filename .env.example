# Copy to .env and adjust. Every value below is the built-in default.
PORT=3000
HOST=0.0.0.0
APP_ENV=development
APP_NAME="Avaluna"
BASE_URL=http://localhost:3000
LOG_LEVEL=info

DATABASE_PATH=data/store.db
AUTO_MIGRATE=true
AUTO_SEED=true

# CHANGE BOTH OF THESE IN PRODUCTION
# Both secrets below MUST be set in production and must then never change.
# ARGON_PEPPER is mixed into every password hash: changing it makes all
# existing passwords unverifiable. JWT_SECRET signs access tokens; changing
# it signs every user out.
#
# If either is left unset the server generates one on first boot and saves it
# to data/.secrets.json (mode 0600) so restarts keep working. Back that file
# up alongside the database, or set the variables explicitly.
JWT_SECRET=change-me-in-production-please-32-bytes-min
ARGON_PEPPER=change-me-too-in-production

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false

DEFAULT_LOCALE=fa
SUPPORTED_LOCALES=fa,en
DEFAULT_CURRENCY=IRR

ENABLE_CRON=true
ENABLE_QUEUE=true
QUEUE_CONCURRENCY=4

ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=Admin@12345
